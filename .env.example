# Copy this file to .env and adjust the values: cp .env.example .env

# Required. SQLAlchemy database URL. A relative SQLite path is created inside instance/.
DATABASE_URL=sqlite:///app.db

# Optional. Lowest log level to print: DEBUG, INFO, WARNING, ERROR. Defaults to INFO.
LOG_LEVEL=INFO

# Optional. Username for the Postgres database. Defaults to "student".
POSTGRES_USER=student
# Optional. Password for the Postgres user. Defaults to "student_pass".
POSTGRES_PASSWORD=student_pass
# Optional. Name of the Postgres database. Defaults to "studentdb".
POSTGRES_DB=studentdb

# Required for docker compose. Image tag for the API (semantic version, never "latest"). Keep in sync with VERSION in the Makefile.
VERSION=1.0.1
